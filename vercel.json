{
  "functions": {
    "api/extract.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/lembretes",
      "schedule": "0 10 * * *"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ],
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/app.html",
      "destination": "/app",
      "permanent": true
    }
  ]
}